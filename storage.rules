rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPdf() {
      return request.resource != null &&
             request.resource.contentType == 'application/pdf';
    }

    // Raw uploads are private to their author. The trusted audio service
    // separately checks lodge, secretary/admin role, session and suspension
    // before it creates a processing job or sends any bytes to Gemini.
    match /meetingAudio/{groupId}/{ownerUid}/{meetingId}/{takeId} {
      allow read, delete: if isSignedIn() && request.auth.uid == ownerUid;
      allow create: if resource == null && isSignedIn() && request.auth.uid == ownerUid &&
        request.resource.size > 0 && request.resource.size <= 60 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/(mp4|m4a|x-m4a|webm|mpeg|mp3|wav|ogg|aac)(;.*)?');
      allow update: if false;
    }

    // Biblioteca de Alejandría uploads. Existing files elsewhere are left untouched.
    match /library/{groupId}/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isPdf() &&
                       request.resource.size < 25 * 1024 * 1024;
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Preserve access to likely legacy library folders without moving old PDFs.
    match /biblioteca/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /bibliotecaAlejandria/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /documents/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Statements and proofs can only be uploaded by the trusted import service.
    match /financeEvidence/{allPaths=**} {
      allow read, write: if false;
    }

    // Existing receipt and notice uploads must retain their current behavior.
    match /{root}/{allPaths=**} {
      allow read, write: if root != 'meetingAudio' && root != 'financeEvidence' && isSignedIn();
    }
  }
}

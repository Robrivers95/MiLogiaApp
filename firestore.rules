rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminOrMaster() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
    }

    function isGroupActive(groupId) {
      return !exists(/databases/$(database)/documents/groups/$(groupId)) ||
             !('active' in get(/databases/$(database)/documents/groups/$(groupId)).data) ||
             get(/databases/$(database)/documents/groups/$(groupId)).data.active == true;
    }

    function isUserGroupActive() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             isGroupActive(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId);
    }

    function isMaster() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    function canWriteLibrary() {
      return isSignedIn() && (isMaster() || isUserGroupActive());
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow create: if isAdminOrMaster();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdminOrMaster();
      allow delete: if isAdminOrMaster();

      match /ledger/{ledgerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
                        (request.auth.uid == userId || isAdminOrMaster()) &&
                        (isMaster() || isUserGroupActive());
      }

      match /attendance/{attendanceId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
                        (request.auth.uid == userId || isAdminOrMaster()) &&
                        (isMaster() || isUserGroupActive());
      }

      match /triviaAnswers/{answerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId && (isMaster() || isUserGroupActive());
        allow write: if isMaster();
      }

      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (request.auth.uid == userId || isAdminOrMaster());
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdminOrMaster());
      }
    }

    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdminOrMaster();

      match /treasury/{entryId} {
        allow read: if isSignedIn();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }

      match /notices/{noticeId} {
        allow read: if isSignedIn();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }

      match /paymentReceipts/{receiptId} {
        allow read: if isSignedIn() &&
                       (isAdminOrMaster() || resource.data.userId == request.auth.uid);
        allow create: if isSignedIn() &&
                         request.resource.data.userId == request.auth.uid;
        allow update: if isAdminOrMaster();
        allow delete: if isAdminOrMaster();
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }
    }

    match /trivias/{triviaId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /visitRequests/{requestId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /bankBalances/{balanceId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /extraFees/{feeId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /gameProfiles/{userId} {
      allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdminOrMaster());
    }

    // Perfil social separado de Registro Logia. Todos los usuarios autenticados
    // pueden ver el directorio; cada persona controla únicamente su propio perfil.
    match /gameSocialProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Salas de juego con jugadores activos + invitados. Los jugadores pueden
    // actualizar el estado del juego; los invitados sólo pueden entrar/salir y chatear.
    match /gameRooms/{roomId} {
      function guestIdsBefore() {
        return ('guestIds' in resource.data) ? resource.data.guestIds : [];
      }
      function bannedIdsBefore() {
        return ('bannedIds' in resource.data) ? resource.data.bannedIds : [];
      }
      function roomLocked() {
        return ('isLocked' in resource.data) && resource.data.isLocked == true;
      }
      function isExistingPlayer() {
        return isSignedIn() && request.auth.uid in resource.data.playerIds;
      }
      function isExistingGuest() {
        return isSignedIn() && request.auth.uid in guestIdsBefore();
      }
      function hostUpdate() {
        return isSignedIn() && request.auth.uid == resource.data.hostUid;
      }
      function playerGameUpdate() {
        return isExistingPlayer() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players', 'currentPlayerIndex', 'currentQuestionId', 'currentCategory',
            'lastDice', 'winnerUid', 'status', 'updatedAt'
          ]);
      }
      function playerSelfLeave() {
        return isExistingPlayer() &&
          !(request.auth.uid in request.resource.data.playerIds) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players', 'playerIds', 'currentPlayerIndex', 'updatedAt'
          ]);
      }
      function guestSelfLeave() {
        return isExistingGuest() &&
          !(request.auth.uid in request.resource.data.guestIds) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guests', 'guestIds', 'updatedAt'
          ]);
      }
      function joinAsPlayer() {
        return isSignedIn() &&
          !roomLocked() &&
          resource.data.status == 'waiting' &&
          !(request.auth.uid in bannedIdsBefore()) &&
          !(request.auth.uid in resource.data.playerIds) &&
          request.auth.uid in request.resource.data.playerIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players', 'playerIds', 'guests', 'guestIds', 'updatedAt'
          ]);
      }
      function joinAsGuest() {
        return isSignedIn() &&
          !roomLocked() &&
          !(request.auth.uid in bannedIdsBefore()) &&
          !(request.auth.uid in resource.data.playerIds) &&
          !(request.auth.uid in guestIdsBefore()) &&
          request.auth.uid in request.resource.data.guestIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guests', 'guestIds', 'updatedAt'
          ]);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.hostUid == request.auth.uid &&
                       request.auth.uid in request.resource.data.playerIds &&
                       request.resource.data.maxAttendees == 20;
      allow update: if hostUpdate() || playerGameUpdate() || playerSelfLeave() || guestSelfLeave() || joinAsPlayer() || joinAsGuest();
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.hostUid || isAdminOrMaster());

      match /chat/{messageId} {
        function parentRoom() {
          return get(/databases/$(database)/documents/gameRooms/$(roomId)).data;
        }
        function parentGuestIds() {
          return ('guestIds' in parentRoom()) ? parentRoom().guestIds : [];
        }
        function isRoomMember() {
          return isSignedIn() &&
            (request.auth.uid in parentRoom().playerIds || request.auth.uid in parentGuestIds());
        }
        allow read: if isRoomMember();
        allow create: if isRoomMember() &&
                         request.resource.data.senderUid == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // Señalización efímera para voz. La interfaz del juego sólo permite entrar
    // a esta llamada a jugadores activos; los invitados no reciben controles de voz.
    match /voiceRooms/{voiceRoomId} {
      allow read: if isSignedIn();

      match /participants/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;

        match /signals/{signalId} {
          allow read, delete: if isSignedIn() && request.auth.uid == userId;
          allow create: if isSignedIn() &&
                           request.resource.data.from == request.auth.uid &&
                           request.resource.data.type in ['offer', 'answer', 'candidate'];
          allow update: if false;
        }
      }
    }

    // Conversaciones privadas uno-a-uno del juego.
    match /directConversations/{conversationId} {
      function isConversationMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      allow create: if isSignedIn() &&
                       request.resource.data.memberIds.size() == 2 &&
                       request.auth.uid in request.resource.data.memberIds;
      allow read: if isConversationMember();
      allow update: if isConversationMember() &&
                       request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/directConversations/$(conversationId)).data;
        }
        function isParentMember() {
          return isSignedIn() && request.auth.uid in parentConversation().memberIds;
        }
        allow read: if isParentMember();
        allow create: if isParentMember() &&
                         request.resource.data.senderUid == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /duels/{duelId} {
      allow create: if isSignedIn() && request.resource.data.challengerUid == request.auth.uid;
      allow read, update: if isSignedIn() &&
                             (resource.data.challengerUid == request.auth.uid ||
                              resource.data.opponentUid == request.auth.uid);
      allow delete: if isAdminOrMaster() ||
                       (isSignedIn() && resource.data.challengerUid == request.auth.uid);
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /libraryPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if canWriteLibrary() && request.resource.data.authorId == request.auth.uid;
      allow update: if canWriteLibrary();
      allow delete: if isAdminOrMaster() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    match /biblioteca/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }

    match /bibliotecaAlejandria/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }

    match /library/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }

    match /publications/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }

    match /documents/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminOrMaster() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
    }

    function isGroupActive(groupId) {
      return !exists(/databases/$(database)/documents/groups/$(groupId)) ||
             !('active' in get(/databases/$(database)/documents/groups/$(groupId)).data) ||
             get(/databases/$(database)/documents/groups/$(groupId)).data.active == true;
    }

    function isUserGroupActive() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             isGroupActive(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId);
    }

    function isMaster() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    function canWriteLibrary() {
      return isSignedIn() && (isMaster() || isUserGroupActive());
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow create: if isAdminOrMaster();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdminOrMaster();
      allow delete: if isAdminOrMaster();

      match /ledger/{ledgerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
                        (request.auth.uid == userId || isAdminOrMaster()) &&
                        (isMaster() || isUserGroupActive());
      }

      match /attendance/{attendanceId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
                        (request.auth.uid == userId || isAdminOrMaster()) &&
                        (isMaster() || isUserGroupActive());
      }

      match /triviaAnswers/{answerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId && (isMaster() || isUserGroupActive());
        allow write: if isMaster();
      }

      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (request.auth.uid == userId || isAdminOrMaster());
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdminOrMaster());
      }
    }

    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdminOrMaster();

      match /treasury/{entryId} {
        allow read: if isSignedIn();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }

      match /notices/{noticeId} {
        allow read: if isSignedIn();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }

      match /paymentReceipts/{receiptId} {
        allow read: if isSignedIn() &&
                       (isAdminOrMaster() || resource.data.userId == request.auth.uid);
        allow create: if isSignedIn() &&
                         request.resource.data.userId == request.auth.uid;
        allow update: if isAdminOrMaster();
        allow delete: if isAdminOrMaster();
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }
    }

    match /trivias/{triviaId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /visitRequests/{requestId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /bankBalances/{balanceId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /extraFees/{feeId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isMaster();
    }

    // Biblioteca de Alejandría. The aliases are intentionally retained so old PDFs,
    // likes and comments can reappear without migrating or deleting production data.
    match /libraryPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if canWriteLibrary() && request.resource.data.authorId == request.auth.uid;
      allow update: if canWriteLibrary();
      allow delete: if isAdminOrMaster() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    match /biblioteca/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }

    match /bibliotecaAlejandria/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }

    match /library/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }

    match /publications/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }

    match /documents/{postId} {
      allow read: if isSignedIn();
      allow update: if canWriteLibrary();
      allow create, delete: if isAdminOrMaster();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin or master
    function isAdminOrMaster() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master'];
    }

    // Helper: admin, master, or viewer (for read-only access)
    function isAdminMasterOrViewer() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master', 'viewer'];
    }
    
    // Helper function to check if user belongs to a group
    function belongsToGroup(groupId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId;
    }
    
    // Helper function to check if a group is active (not suspended)
    function isGroupActive(groupId) {
      return !exists(/databases/$(database)/documents/groups/$(groupId)) ||
             !('active' in get(/databases/$(database)/documents/groups/$(groupId)).data) ||
             get(/databases/$(database)/documents/groups/$(groupId)).data.active == true;
    }

    // Helper: check if current user's group is active
    function isUserGroupActive() {
      return isGroupActive(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId);
    }

    // Helper: is master role
    function isMaster() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }
    
    // Users collection
    match /users/{userId} {
      // Admin/Master/Viewer can read all users
      allow read: if isAdminMasterOrViewer();
      // Anyone can read their own profile
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Users can create their own profile (during registration)
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Admin/Master can create users (v3.0.0: for manual user creation)
      allow create: if isAdminOrMaster();
      // Users can update their own profile
      allow update: if isSignedIn() && request.auth.uid == userId;
      // Admin/Master can update any user
      allow update: if isAdminOrMaster();
      // Admin/Master can delete users
      allow delete: if isAdminOrMaster();
      
      // Subcollections
      match /ledger/{ledgerId} {
        allow read: if isSignedIn() && 
                       (request.auth.uid == userId || isAdminMasterOrViewer());
        allow write: if isSignedIn() && 
                        (request.auth.uid == userId || isAdminOrMaster()) &&
                        (isMaster() || isUserGroupActive());
      }
      
      match /attendance/{attendanceId} {
        allow read: if isSignedIn() && 
                       (request.auth.uid == userId || isAdminMasterOrViewer());
        allow write: if isSignedIn() && 
                        (request.auth.uid == userId || isAdminOrMaster()) &&
                        (isMaster() || isUserGroupActive());
      }
      
      match /triviaAnswers/{answerId} {
        // Users can read their own trivia answers
        allow read: if isSignedIn() && request.auth.uid == userId;
        // Admin/Master/Viewer can also read
        allow read: if isAdminMasterOrViewer();
        // Write blocked if group suspended (except master)
        allow write: if isSignedIn() && request.auth.uid == userId && (isMaster() || isUserGroupActive());
        allow write: if isMaster();
      }
    }
    
    // Groups collection
    match /groups/{groupId} {
      // Anyone can read groups (REQUIRED for registration - users not yet authenticated)
      allow read: if true;
      // Only admin/master can create/update/delete groups
      allow write: if isAdminOrMaster();
      
      // Subcollections
      match /treasury/{entryId} {
        allow read: if belongsToGroup(groupId) || isAdminMasterOrViewer();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }
      
      match /notices/{noticeId} {
        allow read: if belongsToGroup(groupId) || isAdminMasterOrViewer();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }
      
      match /tasks/{taskId} {
        allow read: if belongsToGroup(groupId) || isAdminMasterOrViewer();
        allow write: if isAdminOrMaster() && (isMaster() || isGroupActive(groupId));
      }
    }
    
    // Trivias collection
    match /trivias/{triviaId} {
      // Anyone authenticated can read trivias
      allow read: if isSignedIn();
      // Only admin/master can write, blocked if group suspended (except master)
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }
    
    // Visit Requests collection
    match /visitRequests/{requestId} {
      // Anyone authenticated can read visit requests (to see their own)
      allow read: if isSignedIn();
      // Admin/Master can create visit requests, blocked if group suspended
      allow create: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
      allow update: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
      allow delete: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    // Bank Balances collection
    match /bankBalances/{balanceId} {
      // Admin/Master/Viewer can read bank balances
      allow read: if isAdminMasterOrViewer();
      // Blocked if group suspended (except master)
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    // Extra Fees collection
    match /extraFees/{feeId} {
      // Admin/Master/Viewer can read extra fees
      allow read: if isAdminMasterOrViewer();
      // Blocked if group suspended (except master)
      allow write: if isAdminOrMaster() && (isMaster() || isUserGroupActive());
    }

    // App Configuration collection (for app icons, etc.)
    match /appConfig/{configId} {
      // Anyone can read app configuration (for icons)
      allow read: if true;
      // Only Master can write app configuration
      allow write: if isSignedIn() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }
  }
}
